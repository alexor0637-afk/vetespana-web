# Dependencias
/node_modules

# Lo que genera Next.js (out/ es la web estática ya generada)
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Claves y configuración local: nunca al repositorio
.env*

# Estado local de wrangler (Cloudflare)
.wrangler/

# Registro de la última comprobación de la web generada (tareas/comprobar-salida.mjs)
.ultima-comprobacion.json

# Otros
.claude/
.DS_Store
npm-debug.log*
