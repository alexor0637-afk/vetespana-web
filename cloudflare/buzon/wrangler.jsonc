// Buzón de reseñas y altas (cloudflare/buzon/index.ts) + su base D1. Va aparte de la web para
// que la web sea solo archivos estáticos: así ni los robots ni las páginas que no
// existen gastan peticiones del plan gratuito.
//   npx wrangler deploy --config cloudflare/buzon/wrangler.jsonc
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vetespana-buzon",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "BUZON",
      "database_name": "vetespana-buzon",
      // Lo pone publicar-contenedor.sh desde .env (D1_DATABASE_ID)
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // Avisos por email de cada envío. Con el plan gratis solo se puede escribir a una
  // dirección verificada en Email Routing (la del dueño); el remitente es
  // avisos@vetespana.es. El secreto AVISO_TOKEN (para /aviso) no va aquí: está en
  // el Worker (wrangler secret put) y en ~/homelab/vetespana-web/.env.
  "send_email": [{ "name": "AVISOS", "destination_address": "alexor0637@gmail.com" }],
  "vars": { "AVISOS_DESTINO": "alexor0637@gmail.com" },
  // Los formularios de la web envían a buzon.vetespana.es
  "routes": [{ "pattern": "buzon.vetespana.es", "custom_domain": true }],
  "workers_dev": false, // sin dirección *.workers.dev: los formularios usan buzon.vetespana.es
  "preview_urls": false
}
