// Publicación de la web en Cloudflare: SOLO archivos estáticos (out/), sin código.
// Las peticiones a archivos estáticos son gratis e ilimitadas. El buzón de reseñas y
// altas es otro Worker (worker/wrangler.jsonc).
// Se despliega desde el servidor de casa con `npx wrangler deploy` (ver ~/homelab/vetespana-web).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vetespana-web",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    // /clinicas/x → out/clinicas/x.html ; lo que no existe → out/404.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": false
}
