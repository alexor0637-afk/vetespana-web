// Publicación de la web en Cloudflare: archivos estáticos (out/). Las peticiones a archivos
// estáticos son gratis e ilimitadas. Solo /clinicas pasa antes por un código mínimo
// (cloudflare/web.ts: redirige con 301 las URLs antiguas /clinicas?ciudad=…). El buzón de
// reseñas y altas es otro Worker (cloudflare/buzon/wrangler.jsonc).
// Se despliega desde el servidor de casa con `npx wrangler deploy` (ver ~/homelab/vetespana-web).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vetespana-web",
  "compatibility_date": "2026-09-01",
  "main": "cloudflare/web.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // /clinicas/x → out/clinicas/x.html ; lo que no existe → out/404.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Solo /clinicas (exacta, no las fichas /clinicas/x) pasa por cloudflare/web.ts
    "run_worker_first": ["/clinicas"]
  },
  // Dominios propios (Cloudflare crea sus DNS y certificados). vetespana.es (sin www)
  // lo redirige a www una regla de redirección de la zona (Rules → Redirect Rules),
  // que va antes que el Worker.
  "routes": [
    { "pattern": "www.vetespana.es", "custom_domain": true },
    { "pattern": "vetespana.es", "custom_domain": true }
  ],
  // Sin dirección *.workers.dev: sería una copia de la web que Google podría indexar.
  "workers_dev": false,
  "preview_urls": false
}
