// Publicación de la web en Cloudflare: SOLO archivos estáticos (out/), sin código.
// Las peticiones a archivos estáticos son gratis e ilimitadas. El buzón de reseñas y
// altas es otro Worker (worker/wrangler.jsonc).
// Se despliega desde el servidor de casa con `npx wrangler deploy` (ver ~/homelab/vetespana-web).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vetespana-web",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    // /clinicas/x → out/clinicas/x.html ; lo que no existe → out/404.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Dominios propios (Cloudflare crea sus DNS y certificados). vetespana.es (sin www)
  // lo redirige a www una regla de redirección de la zona (Rules → Redirect Rules),
  // que va antes que el Worker.
  "routes": [
    { "pattern": "www.vetespana.es", "custom_domain": true },
    { "pattern": "vetespana.es", "custom_domain": true }
  ],
  // Sin dirección *.workers.dev: sería una copia de la web que Google podría indexar.
  "workers_dev": false,
  "preview_urls": false
}
